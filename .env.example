# Copy this file to .env.local (already gitignored — see .gitignore's
# `.env*` line) and fill in real values there. Never commit real values.
# Full setup walkthrough: docs/notion-integration.md

# The Notion integration's internal secret ("Internal Integration Secret"
# on the integration's page at notion.so/my-integrations). Server-side
# only — read exclusively by files under src/lib/notion/, every one of
# which starts with `import "server-only"`. Never prefix this with
# NEXT_PUBLIC_ — that would ship it to the browser.
NOTION_API_KEY=

# Optional — defaults to 2022-06-28 in src/lib/notion/env.ts if unset.
# NOTION_API_VERSION=2022-06-28

# One database ID per content type wired up so far. A database's ID is
# the 32-character id in its URL (the part right after the workspace
# name, before the "?v=..." query string) — see docs/notion-integration.md
# for exactly where to find it and what properties each database needs.
NOTION_DATABASE_ID_MOVIES=
NOTION_DATABASE_ID_ANIME=
NOTION_DATABASE_ID_BOOKS=
NOTION_DATABASE_ID_WRITINGS=
